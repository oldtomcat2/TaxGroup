<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/script_edit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <!-- 第1部分：顶部状态栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/colorPrimary"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="返回" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_depart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#BBDEFB"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_page_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="脚本编辑"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_home"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_home"
            android:contentDescription="主页面"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btn_refresh_top"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_rotate"
            android:contentDescription="刷新"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- 第2部分：年月筛选 + 导出 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="年："
            android:textSize="14sp"
            android:textColor="#333333" />

        <Spinner
            android:id="@+id/sp_year"
            android:layout_width="70dp"
            android:layout_height="44dp"
            android:spinnerMode="dropdown"
            android:background="@drawable/bg_spinner"
            android:paddingHorizontal="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="月："
            android:textSize="14sp"
            android:textColor="#333333" />

        <Spinner
            android:id="@+id/sp_month"
            android:layout_width="70dp"
            android:layout_height="44dp"
            android:spinnerMode="dropdown"
            android:background="@drawable/bg_spinner"
            android:paddingHorizontal="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_export"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="导出Excel"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_topic_btn_blue" />
    </LinearLayout>

    <!-- 第3部分：提交状态筛选 -->
    <RadioGroup
        android:id="@+id/rg_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:gravity="center">

        <RadioButton
            android:id="@+id/rb_draft"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="未提交"
            android:textSize="14sp"
            android:textColor="#333333" />

        <RadioButton
            android:id="@+id/rb_submitted"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="已提交"
            android:textSize="14sp"
            android:textColor="#333333" />

        <RadioButton
            android:id="@+id/rb_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="所有"
            android:textSize="14sp"
            android:textColor="#333333" />
    </RadioGroup>

    <!-- 第3部分：提示语句 -->
    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="脚本在还未审核情况下可随时修改。"
        android:textSize="13sp"
        android:textColor="#FF6F00"
        android:textStyle="italic" />

    <!-- 已提交 / 未提交 标签栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已提交脚本："
            android:textSize="13sp"
            android:textColor="#1976D2"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_submitted_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="13sp"
            android:textColor="#1976D2" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="12dp"
            android:background="#CCCCCC" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未提交脚本："
            android:textSize="13sp"
            android:textColor="#FF6F00"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_draft_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="13sp"
            android:textColor="#FF6F00" />
    </LinearLayout>

    <!-- 加载进度条 -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 第4部分：列表展示 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_scripts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="12dp"
        android:clipToPadding="false" />

    <!-- 空状态 -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="暂无脚本记录"
        android:textSize="15sp"
        android:textColor="#999999"
        android:visibility="gone" />

</LinearLayout>
