<?xml version="1.0" encoding="utf-8"?>
<!-- 图标圆形底：白色径向渐变 + 金色描边，制造立体光感 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="56"
        android:startColor="#CCFFFFFF"
        android:endColor="#33FFFFFF"
        android:centerX="0.4"
        android:centerY="0.35" />
    <stroke
        android:width="2dp"
        android:color="#B3E5C97A" />
</shape>