<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/audit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <!-- 顶部状态栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/colorPrimary"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="返回" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_depart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#BBDEFB"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_home"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_home"
            android:contentDescription="主页面"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_rotate"
            android:contentDescription="刷新"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Tab 切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btn_tab_topic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="选题审核"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#1976D2"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_tab_script"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="脚本审核"
            android:textSize="14sp"
            android:background="#E0E0E0"
            android:textColor="#666666" />
    </LinearLayout>

    <!-- 提示信息（脚本审核 Tab 下隐藏） -->
    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="点击部门名称展开/收缩列表"
        android:textSize="13sp"
        android:textColor="#666666"
        android:gravity="center"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <!-- 脚本审核 Tab 下的审核模式 + 年月筛选 -->
    <LinearLayout
        android:id="@+id/ll_audit_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <!-- 审核模式单选（卡片式） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_filter_card"
            android:padding="8dp">

            <!-- level=1：宣传/业务 -->
            <RadioGroup
                android:id="@+id/rg_audit_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:checkedButton="@+id/rb_audit_promote">

                <RadioButton
                    android:id="@+id/rb_audit_promote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="宣传审核"
                    android:textSize="14sp"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rb_audit_business"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="业务审核"
                    android:textSize="14sp"
                    android:textColor="#333333" />
            </RadioGroup>

            <!-- level>1：vet 状态 -->
            <RadioGroup
                android:id="@+id/rg_vet_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:checkedButton="@+id/rb_vet_all"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/rb_vet_pass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="已通过"
                    android:textSize="13sp"
                    android:textColor="#2E7D32" />

                <RadioButton
                    android:id="@+id/rb_vet_reject"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="已退回"
                    android:textSize="13sp"
                    android:textColor="#C62828" />

                <RadioButton
                    android:id="@+id/rb_vet_pending"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="待审核"
                    android:textSize="13sp"
                    android:textColor="#1976D2" />

                <RadioButton
                    android:id="@+id/rb_vet_all"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="所有"
                    android:textSize="13sp"
                    android:textColor="#333333" />
            </RadioGroup>
        </LinearLayout>

        <!-- 年月下拉（卡片式） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_filter_card"
            android:padding="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="年月："
                android:textSize="13sp"
                android:textColor="#666666" />

            <Spinner
                android:id="@+id/sp_year"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_spinner" />

            <Spinner
                android:id="@+id/sp_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_spinner" />
        </LinearLayout>
    </LinearLayout>

    <!-- 部门分组列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_departments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <!-- 空状态 -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="暂无待审核选题"
        android:textSize="15sp"
        android:textColor="#999999"
        android:gravity="center"
        android:visibility="gone" />

    <!-- 加载进度条 -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</LinearLayout>
