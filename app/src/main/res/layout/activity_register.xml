<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_scene"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Logo -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_login_logo"
        android:contentDescription="Logo" />

    <!-- 主标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="古楚轩船"
        android:textColor="@color/gold"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginTop="8dp" />

    <!-- 副标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="新媒体管理系统"
        android:textColor="@color/ink_soft"
        android:textSize="12sp"
        android:letterSpacing="0.2"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp" />

    <!-- 注册卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_login_card"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="20dp"
        android:elevation="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="用户注册"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="16dp" />

        <!-- 手机号 -->
        <EditText
            android:id="@+id/et_phone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_login_input"
            android:hint="请输入手机号（11位）"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_mute"
            android:textSize="14sp"
            android:inputType="phone"
            android:maxLength="11"
            android:maxLines="1"
            android:imeOptions="actionNext"
            android:paddingHorizontal="4dp" />

        <!-- 用户姓名 -->
        <EditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_login_input"
            android:hint="请输入用户姓名"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_mute"
            android:textSize="14sp"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionNext"
            android:paddingHorizontal="4dp" />

        <!-- 所在部门 Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="所在部门"
            android:textColor="@color/ink_soft"
            android:textSize="11sp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/sp_department"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_login_input"
            android:paddingHorizontal="4dp"
            android:spinnerMode="dropdown" />

        <!-- 初始密码 -->
        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_login_input"
            android:hint="请输入初始密码"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_mute"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:maxLines="1"
            android:imeOptions="actionNext"
            android:paddingHorizontal="4dp" />

        <!-- 确认密码 -->
        <EditText
            android:id="@+id/et_password_confirm"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_login_input"
            android:hint="请再次输入密码"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_mute"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:paddingHorizontal="4dp" />

        <!-- 按钮行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <!-- 返回按钮 -->
            <Button
                android:id="@+id/btn_back"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_login_btn"
                android:text="返回"
                android:textColor="@color/paper"
                android:textSize="14sp"
                android:letterSpacing="0.1"
                android:elevation="2dp"
                android:stateListAnimator="@null" />

            <View
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <!-- 提交按钮 -->
            <Button
                android:id="@+id/btn_submit"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_login_btn"
                android:text="提交"
                android:textColor="@color/paper"
                android:textSize="14sp"
                android:letterSpacing="0.1"
                android:elevation="2dp"
                android:stateListAnimator="@null" />
        </LinearLayout>

    </LinearLayout>

    <!-- 页脚 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="© 2026 古楚轩船"
        android:textColor="@color/ink_soft"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:layout_marginTop="16dp" />

</LinearLayout>
</ScrollView>
